@import "tailwindcss";

:root {
  --background: #f4f6f8;
  --foreground: #111827;

  --primary: #0f172a;
  --primary-hover: #1e293b;
  --accent: #d4a72c;

  --success: #15803d;
  --warning: #b45309;
  --danger: #b91c1c;

  --surface: #ffffff;
  --surface-soft: #f8fafc;
  --border-soft: #e5e7eb;

  --shadow-soft: 0 2px 12px rgba(15, 23, 42, 0.06);
  --shadow-card: 0 8px 30px rgba(15, 23, 42, 0.07);
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);

  --color-primary: var(--primary);
  --color-primary-hover: var(--primary-hover);
  --color-accent: var(--accent);
  --color-success: var(--success);
  --color-warning: var(--warning);
  --color-danger: var(--danger);
  --color-surface: var(--surface);
  --color-surface-soft: var(--surface-soft);
  --color-border-soft: var(--border-soft);
}

html {
  -webkit-tap-highlight-color: transparent;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-geist-sans), system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  touch-action: manipulation;
}

* {
  box-sizing: border-box;
}

/* Native-feel interaction */
button,
a {
  transition:
    transform 140ms ease,
    opacity 140ms ease,
    background-color 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease,
    color 180ms ease;
}

button:active,
a:active {
  transform: scale(0.975);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}

/* Premium surface utility */
.nm-card {
  background: var(--surface);
  border: 1px solid var(--border-soft);
  border-radius: 18px;
  box-shadow: var(--shadow-soft);
}

.nm-card-elevated {
  box-shadow: var(--shadow-card);
}

/* Subtle entrance animation */
@keyframes nm-fade-up {
  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.nm-enter {
  animation: nm-fade-up 260ms ease-out both;
}

/* Mobile safe-area support */
.nm-safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

@media print {
  .fixed {
    display: none !important;
  }
}
