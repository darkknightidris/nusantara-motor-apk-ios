      { h: "Brand", x: 11.0, align: "left" as const },
      { h: "Satuan", x: 14.0, align: "left" as const },
      { h: "Modal/pcs", x: 16.0, align: "right" as const },
      { h: "Grosir/pcs", x: 19.6, align: "right" as const },
